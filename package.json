{
  "name": "nant",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "NanT — not an average notetaker. Local video-to-written-tutorial tool.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test",
    "acceptance": "node scripts/acceptance-smoke.js",
    "setup:media": "node scripts/setup-media.js",
    "check": "node --check server.js && node --check public/app.js",
    "sample": "node scripts/export-sample.js",
    "pdfs": "node scripts/export-pdfs.js",
    "sample:local": "node scripts/export-pdfs.js --local",
    "setup:sources": "node scripts/setup-sources.js"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1"
  },
  "license": "MIT"
}
