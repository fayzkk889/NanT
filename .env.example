# Local generation uses an already-running Ollama at 127.0.0.1:11434.
# Leave blank to choose a downloaded model; no cloud model is selected.
OLLAMA_MODEL=
# Windows only: keep an existing WSL Ollama installation awake with the app.
# Leave blank for native Ollama. Does not install or alter any model service.
OLLAMA_WSL_DISTRO=
# Local source tools use Python 3.12. Setup remembers its path in .tools.
PYTHON=
# English speech model installed by setup:sources; inference stays local.
ASR_MODEL=small.en
# hybrid uses local OCR for clear text and vision for diagrams; vision forces the slower reader.
SCREEN_READER=hybrid
# For video screens, set a local FFmpeg executable (or run npm run setup:media).
FFMPEG_PATH=
# Optional OAuth access token with youtube.force-ssl and edit permission for the video.
# A YouTube API key alone cannot download captions.
YOUTUBE_ACCESS_TOKEN=
# Automatic source/prose comparison is local. Set off only for diagnostics.
CONTENT_REVIEW=on
PORT=4317

# Optional hosted app only (Vercel). Never expose these as browser variables.
# Use an unbilled Gemini project; the app cannot inspect a project's billing status.
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VIDEO_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
GEMINI_WRITER_MODEL=gemini-3.5-flash-lite
# OpenRouter is optional for transcript writing; only openrouter/free is used.
OPENROUTER_API_KEY=
# Shared public keys require a persistent Free-plan quota counter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CLOUD_DAILY_REQUESTS=80
# 0 disables the daily per-connection cap. Shared and short-term limits remain.
CLOUD_VISITOR_DAILY_REQUESTS=0
